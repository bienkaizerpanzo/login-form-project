
/* GENERAL PAGE STYLING */
* {
    margin: 0;
    padding: 0;
    box-sizing: border-box;
}

body {
    font-family: Arial, sans-serif;
    background-color: #f1f5f9;
    min-height: 100vh;

    display: flex;
    justify-content: center;
    align-items: center;

    padding: 20px;
}

/* LOGIN FORM HEADING */
h1 {
    color: #1e293b;
    text-align: center;
    font-size: 28px;
    margin-bottom: 25px;
}

/* LOGIN FORM CONTAINER */
form {
    background-color: #ffffff;
    width: 100%;
    max-width: 380px;
    padding: 35px;
    border-radius: 12px;

    box-shadow: 0 4px 15px rgba(0, 0, 0, 0.10);
}

/* INPUT LABELS */
label {
    display: block;
    color: #334155;
    font-weight: bold;
    margin-bottom: 8px;
}

/* USERNAME AND PASSWORD */
input[type="text"],
input[type="password"] {
    width: 100%;
    padding: 12px;
    margin-bottom: 20px;

    border: 1px solid #cbd5e1;
    border-radius: 6px;
    font-size: 14px;
}

/* INPUT FOCUS EFFECT */
input:focus {
    outline: none;
    border-color: #2563eb;
}

/* LOGIN BUTTON */
button {
    width: 100%;
    padding: 12px;

    background-color: #2563eb;
    color: white;

    border: none;
    border-radius: 6px;

    font-size: 16px;
    font-weight: bold;
    cursor: pointer;

    transition: background-color 0.3s ease;
}

/* BUTTON HOVER EFFECT */
button:hover {
    background-color: #1d4ed8;
}

/* RESPONSIVE DESIGN */
@media (max-width: 480px) {
    form {
        padding: 25px;
    }
}
